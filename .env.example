# Local development: APP_ENV=local; blank DEMO_PASSWORD disables the demo gate.
APP_ENV=local
GROQ_API_KEY=replace_with_your_own_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
# Production only: use an actual DNS hostname and matching HTTPS origin.
DEMO_HOST=replace_with_public_hostname
PUBLIC_ORIGIN=
BOOTSTRAP_ON_START=false
EVALUATION_API_URL=http://127.0.0.1:8000
EVALUATION_PAUSE_SECONDS=30

# Optional Render deployment. Leave STORAGE_BACKEND=local for existing PC data.
STORAGE_BACKEND=local
DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_CORPUS_COLLECTION=trace_corpus_cloud_v1
# Dockerfile.render sets this after downloading the pinned model.
ONNX_MODEL_DIRECTORY=
